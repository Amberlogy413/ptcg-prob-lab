name: Auto-update tournament data + deploy

# Owner chose "fully automatic" (2026-06-13): every Monday refresh the real
# tournament data (card usage + archetype decks) from the public Limitless
# API, re-stamp the catalog, verify the exact-math gates, then redeploy.
# The heavy card-pool / trilingual crawl is NOT run here (sets change rarely);
# run scripts/fetch_catalog.mjs + fetch_names.mjs manually when a set drops.

on:
  schedule:
    - cron: "0 6 * * 1" # Mondays 06:00 UTC (~14:00 HKT)
  workflow_dispatch: {} # manual "Run workflow" button

permissions:
  contents: write # push refreshed data + gh-pages

concurrency:
  group: auto-update
  cancel-in-progress: false

jobs:
  refresh:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-node@v4
        with:
          node-version: 22

      - run: npm ci

      - name: Refresh real tournament data (Limitless)
        run: |
          node scripts/fetch_meta.mjs
          node scripts/restamp_meta.mjs
          node scripts/fetch_decks.mjs

      - name: Verify exact-math gates
        run: |
          node --experimental-strip-types scripts/verify_seed.ts
          npx vitest run

      - name: Commit refreshed data
        run: |
          git config user.name "ptcg-data-bot"
          git config user.email "noreply@github.com"
          git add public/catalog/cards-zh-Hant.json public/catalog/decks-zh-Hant.json scripts/meta_usage.json
          git commit -m "data: weekly tournament refresh [skip ci]" || echo "no changes"
          git push

      - name: Build (subpath)
        run: npm run build
        env:
          DEPLOY_BASE: /ptcg-prob-lab/

      - name: Deploy to GitHub Pages
        uses: peaceiris/actions-gh-pages@v4
        with:
          github_token: ${{ secrets.GITHUB_TOKEN }}
          publish_dir: ./dist
          publish_branch: gh-pages
          enable_jekyll: false
